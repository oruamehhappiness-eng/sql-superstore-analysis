-- 1.) Check for NULLs or Duplicates in ms_orderss 
--Expectations : column 'rn' should equal 1
SELECT
    [Order ID],
    [Order Date],
    [Ship Date],
    [Ship Mode],
    [Customer ID],
    [Customer Name],
    Segment,
    Country,
    City,
    [State],
    [Postal Code],
    Region,
    [Product ID],
    Category,
    [Sub-Category],
    [Product Name],
    Sales,
    Quantity,
    Discount,
    Profit,
    COUNT(*) AS DuplicateCount
FROM bronze.ms_orderss
GROUP BY
    [Order ID],
    [Order Date],
    [Ship Date],
    [Ship Mode],
    [Customer ID],
    [Customer Name],
    Segment,
    Country,
    City,
    [State],
    [Postal Code],
    Region,
    [Product ID],
    Category,
    [Sub-Category],
    [Product Name],
    Sales,
    Quantity,
    Discount,
    Profit
HAVING COUNT(*) > 1;

--2.)To get the dataset without duplicates and no nulls
--Expectations : column 'rn' should equal 1
WITH Duplicates AS
(
    SELECT *,
           ROW_NUMBER() OVER (
               PARTITION BY
                    
                   [Order ID],
                   [Order Date],
                   [Ship Date],
                   [Ship Mode],
                   [Customer ID],
                   [Customer Name],
                   Segment,
                   Country,
                   City,
                   [State],
                   [Postal Code],
                   Region,
                   [Product ID],
                   Category,
                   [Sub-Category],
                   [Product Name],
                   Sales,
                   Quantity,
                   Discount,
                   Profit
               ORDER BY [Row ID]
           ) AS rn
    FROM bronze.ms_orderss
)
SELECT *
FROM Duplicates
WHERE rn = 1 

